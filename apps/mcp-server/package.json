{
  "name": "@agentcontext/mcp-server",
  "version": "0.1.0",
  "description": "AgentContext MCP server: reversible context optimization for AI agents (stdio)",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "context",
    "llm",
    "token-optimization"
  ],
  "homepage": "https://github.com/Johannes7549/AgentContext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Johannes7549/AgentContext.git",
    "directory": "apps/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Johannes7549/AgentContext/issues"
  },
  "type": "module",
  "bin": {
    "agentcontext-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentcontext/core": "workspace:*",
    "@agentcontext/observability": "workspace:*",
    "@agentcontext/retrieval": "workspace:*",
    "@agentcontext/shared": "workspace:*",
    "@agentcontext/storage": "workspace:*",
    "@agentcontext/strategies": "workspace:*",
    "@agentcontext/tokenization": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
