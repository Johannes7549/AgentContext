    "@agentcontext/tokenization": "workspace:*",
    "@agentcontext/strategies": "workspace:*",
    "@agentcontext/storage": "workspace:*",
    "@agentcontext/retrieval": "workspace:*",
    "@agentcontext/observability": "workspace:*",
    "@agentcontext/core": "workspace:*"
  }
}
