{
  "name": "@agentcontext/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "AgentContext MCP server (stdio)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
