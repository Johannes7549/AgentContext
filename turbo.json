{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "tsconfig.build.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.test.json",
        "vitest.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": []
    },
    "test": {
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "vitest.config.ts",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/apps/*/src/**"
      ],
      "outputs": []
    }
  }
}
