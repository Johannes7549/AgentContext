{
  "name": "@agentcontext/shared",
  "version": "0.1.1",
  "description": "Domain types, schemas, errors and utilities for AgentContext",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "context",
    "llm",
    "token-optimization"
  ],
  "homepage": "https://github.com/Johannes7549/AgentContext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Johannes7549/AgentContext.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/Johannes7549/AgentContext/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
