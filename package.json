{
  "name": "agentcontext-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "AgentContext — local-first, MCP-native, reversible context optimization engine for AI agents",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tests/tsconfig.json",
    "test": "turbo run test && vitest run --project integration --project e2e",
    "test:all": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
